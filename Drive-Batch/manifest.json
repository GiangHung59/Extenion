{
  "manifest_version": 3,
  "name": "Drive Batch — Tải hàng loạt",
  "version": "0.4.2",
  "description": "Dán nhiều link Drive, chọn file trong thư mục và tải hàng loạt. Không cần cấu hình OAuth.",
  "minimum_chrome_version": "120",
  "permissions": [
    "downloads",
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://accounts.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dán link và tải với Drive Batch"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
