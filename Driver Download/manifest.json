{
  "manifest_version": 3,
  "name": "Drive Batch — Tải hàng loạt",
  "version": "0.3.0",
  "description": "Dán nhiều link Drive, chọn file trong thư mục và tải hàng loạt. Không cần cấu hình OAuth.",
  "minimum_chrome_version": "120",
  "permissions": ["downloads", "storage", "alarms", "scripting"],
  "host_permissions": ["https://drive.google.com/*", "https://docs.google.com/*", "https://drive.usercontent.google.com/*", "https://*.googleusercontent.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16":"icons/icon-16.png", "32":"icons/icon-32.png", "48":"icons/icon-48.png", "128":"icons/icon-128.png"},
  "action": {"default_title": "Dán link và tải với Drive Batch", "default_popup": "index.html?popup=1", "default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png"}}
}
